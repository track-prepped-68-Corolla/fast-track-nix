{ lib, config, ... }:

{
  options.ft.boot.limine = {
    enable = lib.mkEnableOption "the Limine bootloader";
  };

  config = lib.mkIf config.ft.boot.limine.enable {
    boot.loader = {
      limine.enable = true;
      efi.canTouchEfiVariables = true;
      systemd-boot.enable = lib.mkForce false;
    };
  };
}
